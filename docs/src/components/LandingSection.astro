---
interface Props {
  eyebrow: string;
  title: string;
  id?: string;
}
const { eyebrow, title, id } = Astro.props;
---

<section class="not-content bgt-wide flex flex-col gap-5 py-10">
  <div class="flex max-w-180 flex-col gap-2">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id={id} class="text-[28px]/[1.2] font-semibold tracking-[-0.015em] text-ink">
      {title}
    </h2>
    <div class="text-base/relaxed text-pretty text-muted [&_a]:text-accent [&_a:hover]:text-accent-hover">
      <slot name="blurb" />
    </div>
  </div>
  <slot />
</section>
