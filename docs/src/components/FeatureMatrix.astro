---
// Which example shows which feature. Spec features are read from the
// compiled games, and rules and UI features from their source, so the table
// can't fall out of date.
import type { SpecNode } from "@drock07/board-game-toolkit-engine/kinds";
import { catalog } from "board-game-toolkit-examples/catalog";
import { games, type AnyGame } from "board-game-toolkit-examples/registry";
import { readdirSync, readFileSync } from "node:fs";
import { join } from "node:path";
import { href } from "../lib/links";
import { examplesRoot } from "../lib/source";

interface Ctx {
  game: AnyGame;
  nodes: SpecNode[];
  /** The game folder's source, concatenated. */
  source: string;
  ui: string;
}

interface Feature {
  name: string;
  /** Code to show in the name cell. */
  code?: string;
  link: string;
  has: (c: Ctx) => boolean;
}

const kind = (c: Ctx, k: string) => c.nodes.some((n) => n.kind === k);
const zoneVis = (c: Ctx, v: string) =>
  Object.values(c.game.spec.zones).some((z) => z.visibility === v);

const groups: { title: string; features: Feature[] }[] = [
  {
    title: "Flow",
    features: [
      { name: "Turns in seat order", code: "turns", link: "reference/flow/turns/", has: (c) => kind(c, "turns") },
      { name: "A turn that stays open", code: "turn", link: "reference/flow/turn/", has: (c) => kind(c, "turn") },
      { name: "Repeating rounds", code: "loop", link: "reference/flow/loop/", has: (c) => kind(c, "loop") },
      { name: "Branches", code: "branch", link: "reference/flow/branch/", has: (c) => kind(c, "branch") },
      { name: "Everyone at once", code: "simultaneous", link: "reference/flow/simultaneous/", has: (c) => kind(c, "simultaneous") },
      { name: "First answer wins", code: "anyone", link: "reference/flow/anyone/", has: (c) => kind(c, "anyone") },
      { name: "Ways to end early", code: "outcomes", link: "reference/flow/outcomes/", has: (c) => kind(c, "outcomes") },
      { name: "Raised outcomes", code: "{ exit }", link: "reference/flow/outcomes/", has: (c) => /exit: "/.test(c.source) },
      { name: "Labelled prompts", code: "label", link: "reference/flow/prompt/", has: (c) => /label: "/.test(c.source) },
    ],
  },
  {
    title: "State and visibility",
    features: [
      { name: "Per-player zones", code: "perPlayer", link: "concepts/state/", has: (c) => Object.values(c.game.spec.zones).some((z) => z.perPlayer) },
      { name: "Hidden decks", code: '"hidden"', link: "concepts/views/", has: (c) => zoneVis(c, "hidden") },
      { name: "Hands only their owner sees", code: '"owner"', link: "concepts/views/", has: (c) => zoneVis(c, "owner") },
      { name: "Only the top card shows", code: '"top"', link: "concepts/views/", has: (c) => zoneVis(c, "top") },
      { name: "Face-down cards in public zones", code: "faceUp", link: "concepts/views/", has: (c) => /faceUp:/.test(c.source) },
      { name: "Dice and shuffles", code: "tx.random", link: "concepts/determinism/", has: (c) => /tx\.(random|shuffle)\b/.test(c.source) },
    ],
  },
  {
    title: "Effects and hosting",
    features: [
      { name: "Effects", code: "effect", link: "concepts/effects/", has: (c) => (c.game.spec.effects?.length ?? 0) > 0 },
      { name: "Abilities", code: "ability", link: "concepts/effects/", has: (c) => (c.game.spec.abilities?.length ?? 0) > 0 },
      { name: "Bots", code: "controller", link: "guides/bots/", has: (c) => /controller:/.test(c.ui) },
      { name: "Paced playback", code: "useGameEvent", link: "guides/animating-events/", has: (c) => /useGameEvent\(/.test(c.ui) },
      { name: "Effects on screen", code: "useGameEffect", link: "guides/animating-events/", has: (c) => /useGameEffect\(/.test(c.ui) },
      { name: "What a node shows", code: ".shown(view)", link: "reference/flow/shown/", has: (c) => /\.shown\(/.test(c.ui) },
    ],
  },
];

/** Every node of a game: the flow, abilities and effects, through each kind's children. */
function nodesOf(game: AnyGame): SpecNode[] {
  const out: SpecNode[] = [];
  const walk = (n: SpecNode) => {
    out.push(n);
    for (const c of game.kinds[n.kind]?.children(n) ?? []) walk(c);
  };
  for (const root of [
    game.spec.flow,
    ...(game.spec.abilities ?? []),
    ...(game.spec.effects ?? []),
  ])
    walk(root);
  return out;
}

const root = examplesRoot();
const entries = catalog.map((e) => {
  const game = games[e.slug]!;
  const nodes = nodesOf(game);
  const dir = join(root, "games", e.slug);
  const files = readdirSync(dir).filter(
    (f) => /\.tsx?$/.test(f) && !f.includes(".test."),
  );
  const read = (f: string) => readFileSync(join(dir, f), "utf8");
  const source = files.filter((f) => f.endsWith(".ts")).map(read).join("\n");
  const ui = files.filter((f) => f.endsWith(".tsx")).map(read).join("\n");
  return { entry: e, ctx: { game, nodes, source, ui } };
});
---

<div class="not-content bgt-wide overflow-x-auto">
  <table class="w-full border-collapse text-sm">
    <thead>
      <tr class="border-b border-line-strong text-left">
        <th class="py-2 pr-4 font-semibold text-ink">Feature</th>
        <th class="py-2 font-semibold text-ink">Shown in</th>
      </tr>
    </thead>
    {
      groups.map((g) => (
        <tbody>
          <tr>
            <th colspan="2" class="pt-6 pb-2 text-left eyebrow">
              {g.title}
            </th>
          </tr>
          {g.features.map((f) => {
            const shown = entries.filter((x) => f.has(x.ctx));
            return (
              <tr class="border-b border-line align-top">
                <td class="py-2.5 pr-4">
                  <a
                    href={href(f.link)}
                    class="font-medium text-ink hover:text-accent"
                  >
                    {f.name}
                  </a>
                  {f.code && (
                    <code class="ml-2 rounded bg-well px-1.5 py-0.5 font-mono text-xs text-muted">
                      {f.code}
                    </code>
                  )}
                </td>
                <td class="py-2">
                  <div class="flex flex-wrap gap-1.5">
                    {shown.length ? (
                      shown.map((x) => (
                        <a
                          href={href(`examples/${x.entry.slug}/`)}
                          class="rounded-md border border-line bg-panel px-2 py-0.5 text-[13px] text-ink-2 hover:border-accent-line hover:text-accent"
                        >
                          {x.entry.title}
                        </a>
                      ))
                    ) : (
                      <span class="text-subtle">
                        Not in an example yet; see the reference.
                      </span>
                    )}
                  </div>
                </td>
              </tr>
            );
          })}
        </tbody>
      ))
    }
  </table>
</div>
