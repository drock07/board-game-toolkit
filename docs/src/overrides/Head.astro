---
import Default from "@astrojs/starlight/components/Head.astro";
---

<Default />
<script is:inline define:vars={{ base: import.meta.env.BASE_URL }}>
  // The old examples site used hash routes: /#/crazy-eights
  const m = location.hash.match(/^#\/([\w-]*)$/);
  if (m) {
    const slug = m[1];
    location.replace(
      base.replace(/\/?$/, "/") +
        (slug === "flow-gallery"
          ? "examples/flow-gallery/"
          : slug
            ? `examples/${slug}/`
            : ""),
    );
  }
</script>
