{
  "name": "board-game-toolkit-examples",
  "private": true,
  "version": "0.0.0",
  "description": "Example games for the docs site: specs, rules, UIs and tests",
  "type": "module",
  "exports": {
    "./styles.css": "./src/styles.css",
    "./catalog": "./src/catalog.ts",
    "./registry": "./src/games/registry.ts",
    "./games/*": "./src/games/*/index.ts",
    "./games/*/Table": "./src/games/*/Table.tsx",
    "./site/*": "./src/site/*.tsx",
    "./ui/*": "./src/ui/*.tsx",
    "./site/flowTree": "./src/site/flowTree.ts",
    "./demos": "./src/demos/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@drock07/board-game-toolkit-engine": "workspace:*",
    "@drock07/board-game-toolkit-react": "workspace:*",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "clsx": "^2.1.1",
    "motion": "^12.36.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.1.0",
    "react-dom": "^19.0.0",
    "typescript": "catalog:",
    "vite": "^6.0.0",
    "vitest": "catalog:"
  }
}
