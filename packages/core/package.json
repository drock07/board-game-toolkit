{
  "name": "@drock07/board-game-toolkit-core",
  "version": "0.5.0",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drock07/board-game-toolkit.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dice": {
      "types": "./dist/dice/index.d.ts",
      "import": "./dist/dice/index.js"
    },
    "./random": {
      "types": "./dist/random/index.d.ts",
      "import": "./dist/random/index.js"
    },
    "./cards": {
      "types": "./dist/cards/index.d.ts",
      "import": "./dist/cards/index.js"
    },
    "./state-machine": {
      "types": "./dist/stateMachine/index.d.ts",
      "import": "./dist/stateMachine/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
