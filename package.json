{
  "name": "board-game-toolkit",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @drock07/board-game-toolkit-core build",
    "build:react": "pnpm --filter @drock07/board-game-toolkit-react build",
    "build:examples": "pnpm --filter board-game-toolkit-examples build",
    "dev": "pnpm -r --parallel dev",
    "dev:examples": "pnpm --filter board-game-toolkit-examples dev",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0"
  }
}
